NODE_ENV=development
PORT=4318
# Any PostgreSQL. The hosted deployment runs on Neon: use the pooled host
# (the one with -pooler in it) on the server, and the direct host for
# `pnpm db:migrate`, which runs DDL. See docs/hosting.md.
DATABASE_URL=
# Object storage only — the database above is separate, and this whole section
# is optional. It backs one route, /v1/storage/upload, which the desktop app
# doesn't call yet: challenge artifacts and workspace files both ride inline in
# Postgres. Leave both this pair and OBJECT_STORAGE_* empty and the API boots
# fine, just 503s on that one route.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AUTH_SECRET=generated-by-pnpm-setup
# Where the API answers from the outside; Better Auth checks requests against it.
AUTH_BASE_URL=http://localhost:4318
# Verification and password-reset codes. Leave both empty when running from
# source and the codes are written to the API log instead of being emailed —
# production refuses to start without them. See docs/hosting.md.
RESEND_API_KEY=
EMAIL_FROM=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=spar
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Agent traces. Langfuse is the supported premade UI and may be its hosted
# service or a self-hosted instance. These keys stay on the API server; the
# desktop sends traces only to Spar's authenticated API.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LangSmith direct run ingestion. These are server-only; the API posts the
# completed trace to the configured project. Do not put the key in the desktop.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_OTEL_ENABLED=true
# Vendor-neutral alternative for Phoenix or an OTEL collector. A collector can
# route traces onward to any backend that supports its chosen exporter.
# Headers are a JSON object. When this URL is set it takes precedence over the
# Langfuse convenience variables above.
TELEMETRY_OTLP_TRACES_URL=
TELEMETRY_OTLP_HEADERS=
# Optional for local/CI eval uploads. Use a dedicated Spar account token.
SPAR_TELEMETRY_ORIGIN=
SPAR_TELEMETRY_TOKEN=
SPAR_API_ORIGIN=http://localhost:4318
VITE_DEV_SERVER_URL=http://localhost:5173
