{
  "name": "@spar/api",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wait-on file:../../packages/domain/dist/index.js file:../../packages/database/dist/index.js && tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "storage:provision": "tsx src/provisionStorage.ts",
    "storage:verify": "tsx src/verifyStorage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.0.0",
    "@spar/database": "workspace:*",
    "@spar/domain": "workspace:*",
    "@supabase/supabase-js": "^2.111.0",
    "drizzle-orm": "^0.44.3",
    "fastify": "^5.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}
