{
  "name": "@spar/practice",
  "version": "0.3.0",
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "development": "./src/index.ts", "default": "./dist/index.js" },
    "./mcp": { "types": "./src/mcp/index.ts", "development": "./src/mcp/index.ts", "default": "./dist/mcp/index.js" }
  },
  "bin": { "spar-practice-mcp": "./dist/mcp/stdio.js" },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@spar/domain": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
